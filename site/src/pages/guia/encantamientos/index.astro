---
import BaseLayout from "../../../layouts/BaseLayout.astro";
import PageHero from "../../../components/PageHero.astro";
import WorldBackdrop from "../../../components/WorldBackdrop.astro";
import Breadcrumbs from "../../../components/Breadcrumbs.astro";
import Icon from "../../../components/Icon.astro";
import { enchantFamilies } from "../../../data/guide/enchantments";
import { euros } from "../../../lib/money";
import FortuneExplainer from "../../../components/FortuneExplainer.astro";
---

<BaseLayout title="Encantamientos" description="Las 14 familias custom, niveles I–VI, compatibilidades y porcentajes explicados con ejemplos.">
  <PageHero eyebrow="Guía CobbleCraft" title="ENCANTAMIENTOS" subtitle="14 familias · Nivel I a VI · Cada bonus, explicado." />

  <WorldBackdrop>
    <section class="section">
      <div class="container">
        <Breadcrumbs items={[{ label: "Guía", href: "/guia" }, { label: "Encantamientos" }]} />

        <div class="card" style="margin-bottom:26px;">
          <p style="margin:0;">
            Cada familia se compra en <strong>Tier I al Encantador (Hub)</strong>. Para subir de tier,
            combina 2 libros idénticos en un yunque - hasta un máximo de <strong>Tier VI</strong>.
          </p>
        </div>

        <FortuneExplainer />

        <div class="enchant-grid">
          {enchantFamilies.map((f) => (
            <div class="card enchant-card" id={f.id}>
              <div class="icon-tile icon-tile--purple"><Icon name="libro" /></div>
              <h2>{f.name}</h2>
              <p>{f.effect}</p>
              <p><strong>Compatible:</strong> {f.appliesTo}</p>
              <ol class="enchant-levels" aria-label={`Valores por nivel de ${f.name}`}>{f.tiers?.map((value,index)=><li><span>{["I","II","III","IV","V","VI"][index]}</span><strong>{value}</strong></li>)}</ol>
              <div class="enchant-card__foot">
                <span class="badge badge--gold">Tier I: {euros(f.tier1Price)}</span>
                {f.itemSlug && <a href={`/guia/items/${f.itemSlug}`}>Ver ítem →</a>}
              </div>
            </div>
          ))}
        </div>
      </div>
    </section>
  </WorldBackdrop>
</BaseLayout>

<style>
  .enchant-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }
  .enchant-card h2 {
    margin: 0 0 8px;
    font-size: 1.05rem;
  }
  .enchant-card p {
    margin: 0 0 14px;
    font-size: 0.9rem;
    color: var(--text-muted);
  }
  .enchant-card__foot {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 10px;
    flex-wrap: wrap;
  }
  .enchant-card__foot a {
    color: var(--cyan-ink);
    font-weight: 600;
    font-size: 0.88rem;
  }
</style>
<style>
  .enchant-levels { display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:0;list-style:none;margin:16px 0;padding:0;border-top:1px solid var(--border); }
  .enchant-levels li { padding:9px 4px;display:grid;gap:2px;font-size:13px; }
  .enchant-levels span { color:var(--text-muted);font-size:11px; }
  .enchant-levels strong { color:var(--cyan-ink); }
</style>
