---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import Icon from "../../components/Icon.astro";
import PageHero from "../../components/PageHero.astro";
import OperationsStatus from "../../components/OperationsStatus.astro";
import SkinsCollection from "../../components/SkinsCollection.astro";
import { getVisibleProducts, getVisibleCategories, categoryLabels } from "../../lib/catalog";
import type { IconName } from "../../lib/icons";
import type { ProductCategory } from "@shared/catalog-schema";
import { siteConfig } from "@shared/site.config";

const products = getVisibleProducts();
const categories = getVisibleCategories();

const categoryIcons: Record<ProductCategory, IconName> = {
  rangos: "medalla",
  upgrades: "flecha",
  skins: "cristal",
  kits: "coleccion",
  ventajas: "check",
  cosmeticos: "cristal",
  items: "material",
  otros: "coleccion",
};

const rankProducts = products.filter((p) => p.category === "rangos" && !p.devOnly);
const rankComparisonRows = [
  ["Homes", "2", "4", "6"],
  ["/healing", "5 min", "2 min", "1 min"],
  ["/pcremoto", "Sin cooldown", "Sin cooldown", "Sin cooldown"],
  ["Teleports Hub", "Básicos", "Relevantes", "Premium"],
  ["Entrenamiento / hora", "1.500 € ingame", "1.000 € ingame", "500 € ingame"],
  ["Mesa de crafteo", "Sí", "Sí", "Sí"],
  ["Mercado / Ender Chest / back", "-", "Sí", "Sí"],
  ["Prioridad de entrada", "Sobre normal", "Sobre Explorador", "Máxima"],
];
---

<BaseLayout title="Tienda" description="Skins cosméticas de compra directa y suscripciones oficiales de CobbleCraft. Pagos gestionados por Tebex.">
  <PageHero eyebrow="Tienda oficial" title="TIENDA" subtitle="Explorador 3,99 €/mes · Maestro 6,99 €/mes · Leyenda 9,99 €/mes" />
  <OperationsStatus />
  <nav class="container store-categories" aria-label="Categorías de tienda"><a href="#rangos">Rangos</a><a href="#skins">Skins</a></nav>
  <SkinsCollection />

  {products.length === 0 && (
    <div class="container section">
      <div class="empty-state store-coming-soon">
        <Icon name="tienda" size={44} />
        <h2>Próximamente</h2>
        <p>
          La tienda visual de CobbleCraft está preparada para Tebex, pero no hay productos visibles
          en este entorno.
        </p>
        <div class="hero__actions">
          {siteConfig.links.discord && (
            <a class="btn btn-primary" href={siteConfig.links.discord} target="_blank" rel="noopener noreferrer">
              Discord oficial
            </a>
          )}
          <a class="btn btn-ghost" href="/guia">Ver guía</a>
        </div>
      </div>
    </div>
  )}

  <section class="section section--tight section--alt" id="rangos">
    <div class="container">
      <div class="section-head" style="max-width:760px;">
        <span class="eyebrow">Rangos</span>
        <h2>Un rango, una suscripción mensual</h2>
        <p>
          Maestro incluye Explorador; Leyenda incluye Maestro. La cancelación conserva el rango
          hasta finalizar el periodo pagado. No se borran homes, Pokémon ni progreso al caducar.
        </p>
      </div>
      <div class="grid grid--3">
        {rankProducts.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  {categories.filter((cat) => cat !== "rangos" && cat !== "skins").map((cat, i) => (
    <>
      <section class={`section section--tight ${i % 2 === 1 ? "section--alt" : ""}`}>
        <div class="container">
          <div class="section-head" style="display:flex; align-items:center; gap:14px; margin-bottom:24px;">
            <div class="icon-tile" style="margin:0;"><Icon name={categoryIcons[cat]} /></div>
            <h2 style="margin:0; font-size:1.4rem;">{categoryLabels[cat]}</h2>
          </div>
          <div class="grid grid--3">
            {products.filter((p) => p.category === cat).map((p) => <ProductCard product={p} />)}
          </div>
        </div>
      </section>
    </>
  ))}

  <section class="section section--tight">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Comparativa</span>
        <h2>Beneficios por tier</h2>
      </div>
      <div class="comparison-wrap">
        <table class="plain comparison">
          <thead>
            <tr>
              <th>Beneficio</th>
              <th>Explorador</th>
              <th>Maestro</th>
              <th>Leyenda</th>
            </tr>
          </thead>
          <tbody>
            {rankComparisonRows.map((row) => (
              <tr>
                {row.map((cell) => <td>{cell}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="notice" style="margin-top:18px;">
        Gestiona o cancela tu suscripción desde <a href="https://checkout.tebex.io/payment-history" target="_blank" rel="noopener noreferrer">Tebex</a>.
        No compres otro rango mientras tengas un periodo activo. Los cambios de ciclo requieren disponibilidad confirmada en Tebex.
      </p>
    </div>
  </section>

  <div class="divider"><span class="divider__glyph"></span></div>

  <section class="section" style="text-align:center;">
    <div class="container" style="max-width:720px;">
      <div class="icon-tile icon-tile--cyan" style="margin-left:auto; margin-right:auto;">
        <Icon name="escudo" />
      </div>
      <h2>Compra clara y responsable</h2>
      <p>
        No vendemos llaves de crates ni loot aleatorio por dinero real. Los rangos publicados son
        mensuales; cualquier entrega se valida servidor-side y queda
        vinculada al usuario de Minecraft Java indicado al comprar.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .store-categories { display:flex;gap:28px;padding-top:20px;padding-bottom:16px;border-bottom:1px solid var(--border);font-weight:700;font-size:14px; }
  .store-coming-soon {
    max-width: 760px;
    margin: 0 auto;
  }
  .store-coming-soon h2 {
    margin-top: 14px;
  }
  .store-coming-soon p {
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }
  .comparison-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    box-shadow: var(--shadow-soft);
  }
  .comparison {
    min-width: 720px;
  }
  .comparison th:not(:first-child),
  .comparison td:not(:first-child) {
    text-align: center;
  }
</style>
