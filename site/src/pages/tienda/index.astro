---
import BaseLayout from "../../layouts/BaseLayout.astro";
import ProductCard from "../../components/ProductCard.astro";
import Icon from "../../components/Icon.astro";
import PageHero from "../../components/PageHero.astro";
import OperationsStatus from "../../components/OperationsStatus.astro";
import { getVisibleProducts, getVisibleCategories, categoryLabels } from "../../lib/catalog";
import type { IconName } from "../../lib/icons";
import type { ProductCategory } from "@shared/catalog-schema";
import { siteConfig } from "@shared/site.config";

const products = getVisibleProducts();
const categories = getVisibleCategories();

const categoryIcons: Record<ProductCategory, IconName> = {
  rangos: "medalla",
  upgrades: "flecha",
  skins: "cristal",
  kits: "coleccion",
  ventajas: "check",
  cosmeticos: "cristal",
  items: "material",
  otros: "coleccion",
};

const plannedCategories = [
  { icon: "cristal", title: "Skins", description: "Próximamente: skins directas con imagen, preview, precio conocido y compra sin azar." },
] as const;

const rankProducts = products.filter((p) => p.category === "rangos" && !p.devOnly);
const rankComparisonRows = [
  ["Homes", "2", "4", "6"],
  ["/healing", "60 min", "30 min", "15 min"],
  ["/pcremoto", "-", "60 min", "30 min"],
  ["Teleports Hub", "Básicos", "Relevantes", "Premium"],
  ["Kit semanal", "Básico", "Mejorado", "Premium equilibrado"],
  ["Prioridad de entrada", "Sobre normal", "Sobre Explorador", "Máxima"],
];
---

<BaseLayout title="Tienda" description="Tienda oficial de CobbleCraft con rangos permanentes y checkout Tebex hospedado.">
  <PageHero eyebrow="Tienda oficial" title="TIENDA" subtitle="Rangos permanentes con checkout hospedado por Tebex y entrega validada por webhook firmado." />
  <OperationsStatus />

  {products.length === 0 && (
    <div class="container section">
      <div class="empty-state store-coming-soon">
        <Icon name="tienda" size={44} />
        <h2>Próximamente</h2>
        <p>
          La tienda visual de CobbleCraft está preparada para Tebex, pero no hay productos visibles
          en este entorno.
        </p>
        <div class="hero__actions">
          {siteConfig.links.discord && (
            <a class="btn btn-primary" href={siteConfig.links.discord} target="_blank" rel="noopener noreferrer">
              Discord oficial
            </a>
          )}
          <a class="btn btn-ghost" href="/guia">Ver guía</a>
        </div>
      </div>
    </div>
  )}

  <section class="section section--tight section--alt">
    <div class="container">
      <div class="section-head" style="max-width:760px;">
        <span class="eyebrow">Rangos</span>
        <h2>Permanentes y acumulativos</h2>
        <p>
          Maestro incluye Explorador. Leyenda incluye Maestro y Explorador. Los upgrades no están
          disponibles todavía; ahora solo están activos los tres rangos completos.
        </p>
      </div>
      <div class="grid grid--3">
        {rankProducts.map((p) => <ProductCard product={p} />)}
      </div>
    </div>
  </section>

  {categories.filter((cat) => cat !== "rangos").map((cat, i) => (
    <>
      <section class={`section section--tight ${i % 2 === 1 ? "section--alt" : ""}`}>
        <div class="container">
          <div class="section-head" style="display:flex; align-items:center; gap:14px; margin-bottom:24px;">
            <div class="icon-tile" style="margin:0;"><Icon name={categoryIcons[cat]} /></div>
            <h2 style="margin:0; font-size:1.4rem;">{categoryLabels[cat]}</h2>
          </div>
          <div class="grid grid--3">
            {products.filter((p) => p.category === cat).map((p) => <ProductCard product={p} />)}
          </div>
        </div>
      </section>
    </>
  ))}

  <section class="section section--tight">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Comparativa</span>
        <h2>Beneficios por tier</h2>
      </div>
      <div class="comparison-wrap">
        <table class="plain comparison">
          <thead>
            <tr>
              <th>Beneficio</th>
              <th>Explorador</th>
              <th>Maestro</th>
              <th>Leyenda</th>
            </tr>
          </thead>
          <tbody>
            {rankComparisonRows.map((row) => (
              <tr>
                {row.map((cell) => <td>{cell}</td>)}
              </tr>
            ))}
          </tbody>
        </table>
      </div>
      <p class="notice" style="margin-top:18px;">
        Los upgrades se activarán más adelante. Por ahora la tienda solo permite comprar los rangos completos.
      </p>
    </div>
  </section>

  <section class="section section--tight section--alt">
    <div class="container">
      <div class="section-head">
        <span class="eyebrow">Próximamente</span>
        <h2>Skins</h2>
        <p>
          Esta categoría queda preparada para skins directas: imagen, Pokémon o armadura, nombre,
          precio, preview y compra conocida. No habrá recompensa aleatoria ni llaves de crates por
          dinero real.
        </p>
      </div>
      <div class="grid grid--3">
        {plannedCategories.map((category) => (
          <div class="card">
            <div class="icon-tile"><Icon name={category.icon} /></div>
            <h3>{category.title}</h3>
            <p>{category.description}</p>
            <span class="badge badge--muted">Próximamente</span>
          </div>
        ))}
      </div>
    </div>
  </section>

  <div class="divider"><span class="divider__glyph"></span></div>

  <section class="section" style="text-align:center;">
    <div class="container" style="max-width:720px;">
      <div class="icon-tile icon-tile--cyan" style="margin-left:auto; margin-right:auto;">
        <Icon name="escudo" />
      </div>
      <h2>Nuestra postura: nunca pay-to-win</h2>
      <p>
        No vendemos llaves de crates ni loot aleatorio por dinero real. Los rangos publicados son
        permanentes, claros y acumulativos; cualquier entrega se valida servidor-side y queda
        vinculada al usuario de Minecraft Java indicado al comprar.
      </p>
    </div>
  </section>
</BaseLayout>

<style>
  .store-coming-soon {
    max-width: 760px;
    margin: 0 auto;
  }
  .store-coming-soon h2 {
    margin-top: 14px;
  }
  .store-coming-soon p {
    max-width: 560px;
    margin-left: auto;
    margin-right: auto;
  }
  .comparison-wrap {
    overflow-x: auto;
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--bg-card);
    box-shadow: var(--shadow-soft);
  }
  .comparison {
    min-width: 720px;
  }
  .comparison th:not(:first-child),
  .comparison td:not(:first-child) {
    text-align: center;
  }
</style>
