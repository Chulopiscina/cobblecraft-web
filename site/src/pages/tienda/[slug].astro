---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Icon from "../../components/Icon.astro";
import PageHero from "../../components/PageHero.astro";
import { publicApiBaseUrl } from "../../lib/api-base";
import { getVisibleProducts, categoryLabels } from "../../lib/catalog";
import type { DeliveryAction } from "@shared/catalog-schema";

export function getStaticPaths() {
  return getVisibleProducts().map((product) => ({ params: { slug: product.slug }, props: { product } }));
}

const { product } = Astro.props;
const priceLabel = (product.priceCents / 100).toFixed(2).replace(".", ",") + " €";
const durationLabel = product.metadata.durationLabel;
const benefits = product.metadata.benefits?.split("|").filter(Boolean) ?? [];
const isUpgrade = product.metadata.kind === "upgrade";
const apiBaseUrl = publicApiBaseUrl;

/**
 * Descripción de "qué incluye" en lenguaje de jugador - nunca expone el `DeliveryAction` técnico
 * (rankId/customItemId internos) directamente, solo un resumen legible por tipo.
 */
function deliverySummary(action: DeliveryAction): string[] {
  const lines: string[] = [];
  if (action.type === "RANK") lines.push(`Rango del servidor${action.durationDays ? ` (${action.durationDays} días)` : " (permanente)"}.`);
  if (action.type === "CUSTOM_ITEM" || action.type === "COSMETIC") lines.push(`${action.amount ?? 1}x objeto exclusivo, entregado directamente en tu inventario o buzón.`);
  if (action.type === "CURRENCY") lines.push("Moneda del servidor.");
  if (action.type === "BUNDLE" && action.bundle) {
    for (const sub of action.bundle) lines.push(...deliverySummary(sub));
  }
  return lines;
}
const includes = deliverySummary(product.delivery);
---

<BaseLayout title={product.name} description={product.description}>
  <PageHero eyebrow={categoryLabels[product.category]} title={product.name} subtitle={product.description}>
    <Fragment slot="before">
      <p style="margin-bottom:8px;"><a href="/tienda" style="font-size:0.85rem; font-weight:600;">← Volver a la Tienda</a></p>
      <div class="product-hero-icon">
        {/* alt="" deliberado: redundante con el <h1> inmediatamente debajo, ver ProductCard.astro para el mismo criterio. */}
        <img src={product.icon} alt="" width="88" height="88" />
      </div>
    </Fragment>
    {product.devOnly && (
      <Fragment slot="badge">
        <div style="margin-top:6px;"><span class="badge badge--muted">DEV - no disponible en producción</span></div>
      </Fragment>
    )}
    <div style="display:flex; justify-content:center; gap:10px; flex-wrap:wrap; margin-top:20px;">
      <div class="badge badge--gold" style="font-size:1.15rem; padding:8px 18px;">{priceLabel}</div>
      {durationLabel && <div class="badge badge--grass" style="font-size:1.15rem; padding:8px 18px;">{durationLabel}</div>}
    </div>
  </PageHero>

  <section class="section section--tight">
    <div class="container" style="max-width:640px;">
      <div class="card panel-notch" style="text-align:left;">
        <div style="display:flex; align-items:center; gap:10px; margin-bottom:4px;">
          <Icon name="check" size={18} style="color:var(--cyan);" />
          <h2 style="font-size:1.05rem; margin:0;">Qué incluye</h2>
        </div>
        <ul class="plain-list">
          {(benefits.length > 0 ? benefits : includes).map((line) => <li>{line}</li>)}
        </ul>

        {isUpgrade && (
          <p class="notice" style="margin-top:18px;">
            Este producto es un upgrade: solo cobra la diferencia respecto al rango indicado.
            No compres un upgrade si no tienes ya el rango de origen.
          </p>
        )}

        <div style="display:flex; align-items:center; gap:10px; margin:22px 0 4px;">
          <Icon name="candado" size={18} style="color:var(--gold-soft);" />
          <h2 style="font-size:1.05rem; margin:0;">Condiciones</h2>
        </div>
        <ul class="plain-list">
          <li>La entrega queda pendiente hasta que el servidor confirme el pago y procese el pedido. Puedes consultar su estado tras la compra.</li>
          <li>Necesitas una cuenta de Minecraft Java válida y el nombre EXACTO de tu personaje.</li>
          {product.limits.maxPerPlayer && <li>Límite de {product.limits.maxPerPlayer} por jugador.</li>}
          <li>No se garantiza reembolso una vez entregado el producto - ver <a href="/legal/reembolsos">Política de reembolsos</a>.</li>
        </ul>

        <form id="purchase-form" data-api-base={apiBaseUrl} data-product-id={product.productId} data-checkout-enabled={String(product.checkoutEnabled)} style="margin-top:26px; border-top:1px solid var(--border); padding-top:22px;">
          <label for="player-name" class="field-label">Tu nombre de usuario de Minecraft</label>
          <input
            id="player-name"
            name="playerName"
            type="text"
            required
            minlength="3"
            maxlength="16"
            pattern="[A-Za-z0-9_]{3,16}"
            placeholder="Ej: Notch"
            class="input"
          />
          <label style="display:flex; align-items:flex-start; gap:10px; margin-top:14px;">
            <input type="checkbox" required name="confirmedName" />
            <span>He comprobado que el nombre de Minecraft es correcto.</span>
          </label>
          <button type="submit" class="btn btn-primary btn-block btn-lg" style="margin-top:16px;" id="purchase-submit" data-label={`Comprar por ${priceLabel}`} disabled>
            Comprobando disponibilidad...
          </button>
          <p style="margin:12px 0 0; font-size:0.78rem; text-align:center; display:flex; align-items:center; justify-content:center; gap:6px;">
            <Icon name="candado" size={14} />
            Checkout hospedado por Tebex · entrega validada por webhook firmado
          </p>
          <p id="purchase-error" class="notice notice--error" role="alert" aria-live="assertive" style="display:none; margin-top:12px;"></p>
          {!product.checkoutEnabled && (
            <p class="notice" style="margin-top:12px;">
              Producto publicado en la tienda, pero los pagos se activarán cuando existan los
              paquetes reales de Tebex, el webhook firmado y el payout de la cuenta.
            </p>
          )}
        </form>
      </div>
    </div>
  </section>
</BaseLayout>

<style>
  .product-hero-icon {
    width: 128px;
    height: 128px;
    margin: 18px auto 14px;
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 50%;
    background: radial-gradient(circle, rgba(212, 175, 55, 0.28), transparent 70%);
    border: 1px solid rgba(212, 175, 55, 0.3);
  }
  .product-hero-icon img {
    filter: drop-shadow(0 0 16px rgba(212, 175, 55, 0.3));
  }
  .plain-list {
    margin: 12px 0 0;
    padding-left: 4px;
    line-height: 1.8;
    list-style: none;
  }
  .plain-list li {
    padding-left: 20px;
    position: relative;
  }
  .plain-list li::before {
    content: "";
    position: absolute;
    left: 2px;
    top: 11px;
    width: 6px;
    height: 6px;
    background: var(--cyan);
    transform: rotate(45deg);
  }
</style>

<script>
  const form = document.getElementById("purchase-form") as HTMLFormElement | null;
  const submitBtn = document.getElementById("purchase-submit") as HTMLButtonElement | null;
  const errorBox = document.getElementById("purchase-error");
  let available = false;
  const resumeOrder = new URLSearchParams(window.location.search).get("resumeOrder");
  const validResume = resumeOrder && /^ord_[A-Z2-9]{20}$/.test(resumeOrder) ? resumeOrder : null;

  async function checkAvailability() {
    if (!form || !submitBtn || !errorBox) return;
    try {
      const response = await fetch(`${form.dataset.apiBase}/api/store/status`, { signal: AbortSignal.timeout(5000) });
      const status = await response.json();
      available = response.ok && status.checkoutAvailable === true && form.dataset.checkoutEnabled === "true";
      submitBtn.disabled = !available;
      submitBtn.textContent = available ? validResume ? "Reanudar pedido en Tebex" : submitBtn.dataset.label ?? "Comprar" : "Pagos temporalmente no disponibles";
      if (validResume) {
        for (const input of form.querySelectorAll("input")) { input.required = false; input.disabled = true; }
      }
    } catch {
      submitBtn.textContent = "Tienda no disponible";
      errorBox.textContent = "No se pudo consultar la tienda. Vuelve a intentarlo más tarde.";
      errorBox.style.display = "block";
    }
  }
  void checkAvailability();

  async function redirectToCheckout(path: string, body?: Record<string, unknown>) {
    if (!submitBtn || !errorBox || !form) return;
    const apiBase = form.getAttribute("data-api-base");
    if (!apiBase) {
      errorBox.textContent = "La Tienda no está disponible ahora mismo (API no configurada).";
      errorBox.style.display = "block";
      return;
    }

    submitBtn.disabled = true;
    submitBtn.textContent = "Procesando...";
    const res = await fetch(`${apiBase}${path}`, {
      method: "POST",
      headers: { "Content-Type": "application/json" },
      body: body ? JSON.stringify(body) : undefined,
      signal: AbortSignal.timeout(30000),
    });
    const data = (await res.json()) as { checkoutUrl?: string; error?: string };
    if (!res.ok || !data.checkoutUrl) {
      errorBox.textContent = data.error ?? "No se pudo crear el pedido. Comprueba tu nombre de usuario.";
      errorBox.style.display = "block";
      submitBtn.disabled = false;
      submitBtn.textContent = "Reintentar";
      return;
    }
    const target = new URL(data.checkoutUrl);
    const hosted = target.protocol === "https:" && target.hostname === "checkout.tebex.io" && !target.username && !target.password && !target.port && target.pathname.startsWith("/checkout/");
    const localMock = import.meta.env.DEV && target.origin === window.location.origin && target.pathname.startsWith("/tienda/");
    if (!hosted && !localMock) throw new Error("Destino de pago no autorizado.");
    window.location.href = target.href;
  }

  form?.addEventListener("submit", async (event) => {
    event.preventDefault();
    if (!submitBtn || !errorBox) return;
    const productId = form.getAttribute("data-product-id");
    const checkoutEnabled = form.getAttribute("data-checkout-enabled") === "true";
    const playerName = (document.getElementById("player-name") as HTMLInputElement | null)?.value.trim();

    errorBox.style.display = "none";
    if (!checkoutEnabled || !available) {
      errorBox.textContent = "El checkout Tebex de este producto todavía no está activado.";
      errorBox.style.display = "block";
      return;
    }

    try {
      if (validResume) await redirectToCheckout(`/api/orders/${encodeURIComponent(validResume)}/checkout`);
      else await redirectToCheckout("/api/orders", { productId, playerName });
    } catch {
      errorBox.textContent = "No se pudo contactar con el servidor de pagos. Inténtalo de nuevo.";
      errorBox.style.display = "block";
      submitBtn.disabled = false;
      submitBtn.textContent = "Reintentar";
    }
  });
</script>
