---
import type { SkinPreview } from "../lib/skins";
import Icon from "./Icon.astro";
interface Props { skin: SkinPreview; }
const { skin } = Astro.props;
---
<skin-preview class="skin-preview" style={`--skin-accent:${skin.accent}`} data-model={skin.model} data-texture={skin.texture} data-glow={skin.glow}>
  <div class="skin-preview__viewport" role="img" aria-label={`Vista 3D de ${skin.kind} ${skin.title} ${skin.edition}`} tabindex="0">
    <img class="skin-preview__fallback" src={skin.fallback} alt={`${skin.title} ${skin.edition}`} width="96" height="96" loading="lazy" />
  </div>
  <span class="skin-preview__state" role="status">Cargando modelo…</span>
  <div class="skin-preview__tools" role="group" aria-label="Controles de vista 3D">
    <button type="button" data-view="left" aria-label="Girar a la izquierda" title="Girar a la izquierda"><Icon name="flecha" size={18} class="reverse" /></button>
    <button type="button" data-view="reset" aria-label="Restablecer vista" title="Restablecer vista"><Icon name="captura" size={18} /></button>
    <button type="button" data-view="right" aria-label="Girar a la derecha" title="Girar a la derecha"><Icon name="flecha" size={18} /></button>
    <span class="skin-preview__tool-separator"></span>
    <button type="button" data-view="in" aria-label="Acercar" title="Acercar">+</button>
    <button type="button" data-view="out" aria-label="Alejar" title="Alejar">−</button>
  </div>
</skin-preview>
<style>
  .skin-preview { display:block; position:relative; background:#eaf0f3; isolation:isolate; }
  .skin-preview__viewport { position:relative; width:100%; aspect-ratio:1; overflow:hidden; touch-action:pan-y; background:linear-gradient(155deg,#f6f8fa,#e3ebee); }
  .skin-preview__viewport:after { content:""; position:absolute; inset:auto 15% 45px; height:1px; background:#c4d2d8; pointer-events:none; }
  .skin-preview__viewport :global(canvas) { width:100%;height:100%;display:block;position:absolute;inset:0;touch-action:pan-y;cursor:grab; }
  .skin-preview__viewport :global(canvas):active { cursor:grabbing; }
  .skin-preview__fallback { position:absolute;left:50%;top:50%;transform:translate(-50%,-50%);object-fit:contain; }
  .skin-preview[data-ready="true"] .skin-preview__fallback { visibility:hidden; }
  .skin-preview__state { position:absolute;top:14px;left:16px;right:16px;font-size:12px;color:#53646b;pointer-events:none; }
  .skin-preview[data-ready="true"] .skin-preview__state { display:none; }
  .skin-preview__tools { position:absolute;bottom:12px;left:50%;transform:translateX(-50%);display:flex;gap:3px;align-items:center;padding:4px;background:#ffffffed;border:1px solid #c4d2d8;border-radius:6px;z-index:1; }
  .skin-preview__tools button { width:32px;height:32px;display:grid;place-items:center;border:0;border-radius:4px;background:transparent;color:#344951;cursor:pointer;font:22px/1 var(--font-body); }
  .skin-preview__tools button:hover { background:#e7eef1;color:var(--skin-accent); }
  .skin-preview__tools button:disabled { opacity:.35;cursor:default; }
  .skin-preview__tool-separator { height:18px;width:1px;background:#c4d2d8;margin:0 3px; }
  .skin-preview__tools :global(.reverse) { transform:rotate(180deg); }
</style>
<script>
  import { mountSkinPreview } from "../lib/skin-preview";
  class SkinPreviewElement extends HTMLElement {
    cleanup?: () => void;
    observer?: IntersectionObserver;
    connectedCallback() {
      this.observer = new IntersectionObserver(entries => {
        if (!entries.some(entry => entry.isIntersecting)) return;
        this.observer?.disconnect();
        void mountSkinPreview(this).then(cleanup => { if (this.isConnected) this.cleanup = cleanup; else cleanup(); });
      }, { rootMargin:"160px" });
      this.observer.observe(this);
    }
    disconnectedCallback() { this.observer?.disconnect(); this.cleanup?.(); }
  }
  if (!customElements.get("skin-preview")) customElements.define("skin-preview", SkinPreviewElement);
</script>
