---
interface Props {
  size?: "sm" | "md";
}
const { size = "md" } = Astro.props;
---

<div class:list={["brand-heading", { "brand-heading--compact": size === "sm" }]}>
  <slot />
</div>
<style>
  .brand-heading { color:#fff;max-width:800px;margin:auto; }
  .brand-heading :global(h1) { color:#fff;font-size:46px;line-height:1.15;text-shadow:0 2px 10px #0009;overflow-wrap:anywhere; }
  .brand-heading :global(p), .brand-heading :global(.eyebrow) { color:#eefaff!important; }
  .brand-heading :global(.text-gradient-gold) { background:none;color:#ffe39b;-webkit-text-fill-color:currentColor; }
  @media(max-width:600px) { .brand-heading :global(h1) { font-size:27px; } }
</style>
