---
/**
 * Rediseño visual V4 - "placa" tipo cartel para integrar el título/subtítulo del hero dentro de
 * la escena de pradera (ver MeadowScene.astro), con vidrio esmerilado + marco cálido + esquinas
 * en corte voxel. `size="sm"` para cabeceras cortas (solo eyebrow+h1), por defecto para las que
 * incluyen además un párrafo corto.
 */
interface Props {
  size?: "sm" | "md";
}
const { size = "md" } = Astro.props;
---

<div class={size === "sm" ? "hero-plaque hero-plaque--sm" : "hero-plaque"}>
  <span class="hero-plaque__bolt hero-plaque__bolt--tl" aria-hidden="true"></span>
  <span class="hero-plaque__bolt hero-plaque__bolt--tr" aria-hidden="true"></span>
  <span class="hero-plaque__bolt hero-plaque__bolt--bl" aria-hidden="true"></span>
  <span class="hero-plaque__bolt hero-plaque__bolt--br" aria-hidden="true"></span>
  <slot />
</div>
