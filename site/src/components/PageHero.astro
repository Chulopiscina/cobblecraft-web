---
/**
 * Unificación visual (2026-09-05) - cabecera fotográfica reutilizable para CUALQUIER página que
 * no sea la Home (antes cada una improvisaba su propia cabecera - `/vote` usaba `MeadowScene`,
 * una ilustración SVG genérica, mientras que la Home ya usaba la foto real `hero-landscape.png`
 * + `HeroPlaque` - pedido explícito: "quiero que toda la web parezca una única web"). Mismo
 * `hero hero--photo` + `hero__scrim` + `HeroPlaque` que ya usa `index.astro`, en un modo
 * `compact` (menos padding, sin logo/animación) pensado para cabeceras de página interior.
 */
import { Image } from "astro:assets";
import heroLandscape from "../assets/images/hero-landscape.png";
import hub from "../assets/gallery/hub.png";
import fishing from "../assets/gallery/pesca.png";
import league from "../assets/gallery/liga.png";
import slayer from "../assets/gallery/slayer-gengar.png";
import mastery from "../assets/gallery/maestria.png";

interface Props {
  eyebrow?: string;
  title: string;
  subtitle?: string;
  compact?: boolean;
}
const { eyebrow, title, subtitle, compact = true } = Astro.props;
const scene = title.includes("PESCA") ? fishing : title.includes("LIGA") ? league : title.includes("SLAYER") ? slayer : title.includes("MAESTRÍA") ? mastery : title.includes("GUÍA") || title.includes("COBBLECRAFT") || title.includes("PASOS") ? hub : heroLandscape;
---

<section class={compact ? "hero hero--photo hero--compact" : "hero hero--photo"}>
  <Image src={scene} alt="" class="hero__bg" widths={[640, 960, 1280, 1920]} sizes="100vw" loading="eager" fetchpriority="high" format="webp" quality={70} />
  <div class="hero__scrim" aria-hidden="true"></div>
  <div class="container">
    <slot name="before" />
    <div class="page-heading">
      {eyebrow && <span class="eyebrow">{eyebrow}</span>}
      <slot name="badge" />
      <h1>{title}</h1>
      {subtitle && <p>{subtitle}</p>}
    </div>
    <slot />
  </div>
</section>

<style>
  .hero--compact {
    padding: 74px 0 58px;
  }
  .page-heading { max-width:830px;margin:auto;color:#fff; }
  .page-heading h1 { color:#fff;font-size:32px;line-height:1.2;margin:12px 0;letter-spacing:0;overflow-wrap:anywhere;text-shadow:0 2px 8px #0008; }
  .page-heading p { max-width:660px;margin:12px auto 0;color:#eef6fa;font-size:16px;text-shadow:0 1px 4px #000; }
  .page-heading .eyebrow { color:#b5f7f2; }
  @media(max-width:600px) { .page-heading h1 { font-size:25px; } .hero--compact { padding:52px 0 44px; } }
</style>
