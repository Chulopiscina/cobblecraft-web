---
import type { Product } from "@shared/catalog-schema";
import type { SkinPreview } from "../lib/skins";
import SkinPreviewView from "./SkinPreview.astro";
interface Props { product: Product; preview: SkinPreview; }
const { product, preview } = Astro.props;
const price = new Intl.NumberFormat("es-ES",{style:"currency",currency:"EUR"}).format(product.priceCents/100);
---
<article class="skin-product" style={`--skin-accent:${preview.accent}`}>
  <SkinPreviewView skin={preview} />
  <div class="skin-product__body">
    <div class="skin-product__category"><span>{preview.kind}</span><span>Compra directa</span></div>
    <h3>{preview.title} <span>{preview.edition}</span></h3>
    <p>{preview.detail}</p>
    <div class="skin-product__price"><strong>{price}</strong><span>Pago único</span></div>
    <a class="btn btn-primary btn-block" href={`/tienda/${product.slug}/`}>Ver skin y comprar</a>
    {!product.checkoutEnabled && <small>Compra pendiente de activación</small>}
  </div>
</article>
<style>
  .skin-product{border:1px solid var(--border);border-radius:8px;overflow:hidden;background:#fff;min-width:0;display:flex;flex-direction:column;}
  .skin-product__body{padding:23px;display:flex;flex-direction:column;flex:1;}
  .skin-product__category{display:flex;justify-content:space-between;gap:12px;font-size:11px;text-transform:uppercase;font-weight:700;color:#5b6971;margin-bottom:13px;}
  .skin-product__category span:first-child{color:var(--skin-accent);}
  h3{font-family:var(--font-body);font-size:24px;line-height:1.15;margin:0 0 12px;}
  h3 span{display:block;font-size:16px;margin-top:6px;font-weight:500;color:var(--text-muted);}
  p{font-size:14px;line-height:1.65;margin-bottom:20px;flex:1;}
  .skin-product__price{display:flex;align-items:baseline;gap:10px;margin-bottom:15px;}
  .skin-product__price strong{font:700 24px var(--font-body);color:var(--text);}
  .skin-product__price span,small{font-size:12px;color:var(--text-muted);}
  small{display:block;text-align:center;margin-top:10px;}
</style>
